<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="service_order_report" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              uuid="4f2a0f4a-54e8-4c65-9a49-6d9bdf6e27f4">
    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="One Empty Record"/>

    <queryString language="SQL">
        <![CDATA[
        SELECT
            cl.client_id,
            cl.client_name,
            cl.client_email,
            cl.client_phone,
            so.service_order_number,
            so.service_order_date,
            so.service_order_status,
            so.service_order_total_value,
            so.service_order_discount,
            v.vehicle_plate,
            s.service_description,
            item.item_value,
            item.item_observations
        FROM service_order so
                 JOIN vehicle v ON so.vehicle_id = v.vehicle_id
                 JOIN client cl ON v.client_id = cl.client_id
                 JOIN item_os item ON item.service_order_number = so.service_order_number
                 JOIN service s ON s.service_id = item.service_id
        ORDER BY cl.client_name, so.service_order_number, s.service_description
        ]]>
    </queryString>

    <field name="client_id" class="java.lang.Integer"/>
    <field name="client_name" class="java.lang.String"/>
    <field name="client_email" class="java.lang.String"/>
    <field name="client_phone" class="java.lang.String"/>
    <field name="service_order_number" class="java.lang.Integer"/>
    <field name="service_order_date" class="java.util.Date"/>
    <field name="service_order_status" class="java.lang.String"/>
    <field name="service_order_total_value" class="java.math.BigDecimal"/>
    <field name="service_order_discount" class="java.math.BigDecimal"/>
    <field name="vehicle_plate" class="java.lang.String"/>
    <field name="service_description" class="java.lang.String"/>
    <field name="item_value" class="java.math.BigDecimal"/>
    <field name="item_observations" class="java.lang.String"/>

    <variable name="OrderSubtotal" class="java.math.BigDecimal" resetType="Group" resetGroup="OrderGroup" calculation="Sum">
        <variableExpression><![CDATA[$F{item_value}]]></variableExpression>
    </variable>

    <group name="ClientGroup">
        <groupExpression><![CDATA[$F{client_id}]]></groupExpression>
        <groupHeader>
            <band height="44">
                <textField>
                    <reportElement x="0" y="0" width="520" height="18" uuid="d3c6b6ff-6ec4-4a44-b22c-6b3a4b2d2d11"/>
                    <textElement>
                        <font size="14" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Cliente: " + $F{client_name}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="0" y="18" width="520" height="12" uuid="3ae6df13-0f0b-43a4-83b4-2f9d42ef4d64"/>
                    <textElement>
                        <font size="9"/>
                    </textElement>
                    <textFieldExpression><![CDATA["E-mail: " + $F{client_email} + " | Telefone: " + $F{client_phone}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="38" width="782" height="1" uuid="f69b1bb6-5ae4-4671-81ce-0ca8aa87d0a5"/>
                </line>
            </band>
        </groupHeader>
    </group>

    <group name="OrderGroup">
        <groupExpression><![CDATA[$F{service_order_number}]]></groupExpression>
        <groupHeader>
            <band height="62">
                <textField>
                    <reportElement x="0" y="0" width="260" height="14" uuid="c1a6c7df-66ef-46f5-9d81-3e9d2d2b6e45"/>
                    <textElement>
                        <font size="11" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["OS Nº " + $F{service_order_number} + " | Placa: " + $F{vehicle_plate}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="270" y="0" width="220" height="14" uuid="2de0a2de-f3eb-40da-b1c7-b7cbb8fd3cb0"/>
                    <textElement>
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Data: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{service_order_date})]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="500" y="0" width="170" height="14" uuid="d4db3ef5-1da6-4d6d-91e5-53c2f0e0e5d0"/>
                    <textElement>
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Status: " + $F{service_order_status}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="0" y="18" width="220" height="14" uuid="d1cc7254-bb87-48ca-9777-0adfbc90e6b2"/>
                    <textElement>
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Valor bruto: " + new java.text.DecimalFormat("R$ #,##0.00").format($F{service_order_total_value})]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="230" y="18" width="220" height="14" uuid="7ec8e2be-b6a4-4ac5-bcfd-4f5e9d6c0d17"/>
                    <textElement>
                        <font size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Desconto: " + new java.text.DecimalFormat("R$ #,##0.00").format($F{service_order_discount})]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="460" y="18" width="240" height="14" uuid="e1f1abde-d8c8-4ab0-8cc8-3e8cb4f7f1bd"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Total líquido: " + new java.text.DecimalFormat("R$ #,##0.00").format($F{service_order_total_value}.subtract($F{service_order_discount}))]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="0" y="58" width="782" height="1" uuid="3fb87ddc-5b5f-42a9-8cdd-8f60f729b606"/>
                </line>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="18">
                <textField>
                    <reportElement x="0" y="0" width="260" height="14" uuid="11385f3f-1e51-4f11-b452-4e1f14d5a6b9"/>
                    <textElement>
                        <font size="10" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Subtotal dos serviços: " + new java.text.DecimalFormat("R$ #,##0.00").format($V{OrderSubtotal})]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="34">
            <textField>
                <reportElement x="0" y="0" width="782" height="24" uuid="f7ddf5dc-73e6-41d0-9f1f-f7d0a65b6a9c"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Relatório de Ordens de Serviço por Cliente"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="300" height="18" uuid="5d7ff7e8-c2cc-4dd6-84f9-f7e9f0b4d7e1"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Serviço]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="120" height="18" uuid="9d08cd8e-1f8c-4ae7-b783-4e1e2c93a1ae"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Valor]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="342" height="18" uuid="b2b8fbbf-55e6-49a8-91a6-3f5f4c6a4b5d"/>
                <textElement>
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Observações]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="300" height="18" uuid="6d5bf0b8-8b72-4490-8a3d-b13ef7f4ac69"/>
                <textFieldExpression><![CDATA[$F{service_description}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="310" y="0" width="120" height="18" uuid="d53dc7f0-3d22-4a7f-9f9f-f3f9b0d31fdb"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[new java.text.DecimalFormat("R$ #,##0.00").format($F{item_value})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="440" y="0" width="342" height="18" uuid="de69d3ad-1cd6-4c17-9dc4-2f9d5e1a8648"/>
                <textFieldExpression><![CDATA[$F{item_observations}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="200" height="14" uuid="0d1e8f40-91c1-4a44-8df5-3f8f1cb9e6d8"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="682" y="0" width="100" height="14" uuid="0f5d00d0-0c72-4e87-b6e5-4bca343bb5cf"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
