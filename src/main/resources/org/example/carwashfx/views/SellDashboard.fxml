<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" stylesheets="@../../../../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carwashfx.controllers.SellDashboardController">
   <children>
      <MenuBar prefWidth="1080.0">
        <menus>
          <Menu mnemonicParsing="false" text="Início">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#onHandleHome" text="Voltar" />
               </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Veículos">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onHandleRegisterVehicle" text="Cadastrar Veículo" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#onHandleGetVehiclesOnAction" text="Listar Veículos" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Clientes">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onHandleRegisterOwner" text="Cadastrar Cliente" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#onHandleGetOwnersOnAction" text="Listar Clientes" />
            </items>
          </Menu>
            <Menu mnemonicParsing="false" text="Dashboards">
                <items>
                    <MenuItem mnemonicParsing="false" onAction="#onHandleShowAttendanceDashboard" text="Dashboard de Atendimentos" />
                </items>
            </Menu>
        </menus>
      </MenuBar>
      <LineChart fx:id="lcSellDashboard" layoutX="180.0" layoutY="160.0" prefWidth="720.0" title="Receita">
        <xAxis>
          <CategoryAxis side="BOTTOM" />
        </xAxis>
        <yAxis>
          <NumberAxis label="Valores (R$)" side="LEFT" />
        </yAxis>
      </LineChart>
   </children>
</AnchorPane>
