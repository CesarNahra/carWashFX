<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" stylesheets="@../../../../styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.carwashfx.controllers.GetServiceOrdersController">
   <children>
      <MenuBar prefWidth="1080.0">
        <menus>
          <Menu mnemonicParsing="false" text="Início">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onHandleHome" text="Voltar" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <TableView fx:id="tableViewServiceOrders" layoutY="25.0" prefHeight="695.0" prefWidth="1080.0">
        <columns>
          <TableColumn fx:id="tcOrderDate" prefWidth="75.0" text="Data" />
          <TableColumn fx:id="tcOrderValue" prefWidth="83.0" text="Valor Total" />
            <TableColumn fx:id="tcOrderDiscount" prefWidth="75.0" text="Desconto" />
            <TableColumn fx:id="tcOrderStatus" prefWidth="75.0" text="Status" />
            <TableColumn fx:id="tcVehiclePlate" prefWidth="75.0" text="Placa" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
