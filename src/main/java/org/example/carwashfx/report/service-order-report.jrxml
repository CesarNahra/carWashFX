	<dataset name="tableDataset" uuid="f13e6d36-5148-4ecc-bbe3-3035def80980">
		<query language="sql"><![CDATA[]]></query>
	</dataset>
	<query language="SQL"><![CDATA[SELECT 
    -- Client Info
    c.client_id as c_id,
    c.client_name,
    
    -- Vehicle Info
    v.vehicle_id as v_id,
    vb.vehicle_brand_name AS brand,
    vm.vehicle_model_description AS model,

    -- Service Order Info
    so.service_order_number AS os_number,
    so.service_order_date AS os_date,
    so.service_order_status AS os_status,
    so.service_order_total_value AS os_total


FROM service_order so
INNER JOIN vehicle v ON so.vehicle_id = v.vehicle_id
INNER JOIN client c ON v.client_id = c.client_id
INNER JOIN vehicle_model vm ON v.vehicle_model_id = vm.vehicle_model_id
INNER JOIN vehicle_brand vb ON vm.vehicle_brand_id = vb.vehicle_brand_id

ORDER BY so.service_order_number DESC
]]></query>
